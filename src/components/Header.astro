---
import BrandLockup from '@/components/BrandLockup.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/config';
import { NAV_TARGETS, getCopy } from '@/i18n';

const t = getCopy(Astro.currentLocale);
---

<header class="header">
  <a href="#top" class="brand" aria-label={`${SITE.name} ${t.header.kana}`}>
    <BrandLockup class="brand__lockup" />
  </a>
  <nav class="nav" aria-label={t.common.navLabel}>
    <!-- Concept · Saké · Obanzai · Boutique · Access の 5 本 (並びとリンク先は NAV_TARGETS)。1024px 以上だけ表示 -->
    <div class="nav__links">
      {NAV_TARGETS.map((id) => <a href={`#${id}`} class="nav__link">{t.header.nav[id]}</a>)}
    </div>
    <Button href={SITE.phoneHref} ariaLabel={`RESERVATION: ${t.common.reserveByPhone} (${SITE.phone})`} variant="outline" size="sm">
      RESERVATION
    </Button>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-header);
    background: linear-gradient(to bottom, color-mix(in srgb, var(--color-brand) 90%, transparent), transparent);
    color: var(--color-dot-white);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    /* 開演の最後にヘッダーが現れる (spec §7.1) */
    animation: fade-in 1s var(--ease-out) 1.4s both;
  }

  /* アイコン + ロゴのロックアップ (BrandLockup)。ロゴは currentColor でヘッダーの文字色を継ぐ。
     flex-shrink: 0 でナビに押されて潰れないようにする */
  .brand {
    --lockup-height: var(--logo-height-mobile);

    display: block;
    flex-shrink: 0;
    width: fit-content;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    font-size: var(--text-menu);
    line-height: var(--leading-menu);
    letter-spacing: var(--tracking-wide);
  }

  /* リンク 5 本は 1024px 以上だけ。ロックアップ + リンク 5 本 + RESERVATION は 768〜1023px に収まらない (handoff §4.0)。
     それ未満は RESERVATION ボタンだけ (spec §14 #3) */
  .nav__links {
    display: none;
    align-items: center;
    gap: 32px;
  }

  .nav__link {
    transition: color var(--duration-hover);
  }

  .nav__link:hover {
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .header {
      padding: var(--space-header-md);
    }

    .brand {
      --lockup-height: var(--logo-height);
    }
  }

  @media (min-width: 64rem) {
    .nav__links {
      display: flex;
    }
  }
</style>
