---
import { Picture } from 'astro:assets';
import { images } from '@/assets/images';
import { getCopy } from '@/i18n';

const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';
const t = getCopy(lang);
const photo = images.philosophy;
---

<section id="philosophy" class="philosophy" aria-labelledby="philosophy-title">
  <div class="deco" aria-hidden="true">
    <span class="deco__dot deco__dot--1"></span>
    <span class="deco__dot deco__dot--2"></span>
  </div>

  <div class="philosophy__inner">
    <!-- 写真は 1 枚。モバイルでは文章の背面に敷き、デスクトップでは左 55% に置く -->
    <figure class="philosophy__photo">
      <Picture
        src={photo.src}
        formats={['avif', 'webp']}
        widths={[800, 1600]}
        sizes="(min-width: 48rem) 44rem, 100vw"
        alt={photo.alt[lang]}
      />
    </figure>

    <div class="philosophy__text reveal">
      <h2 id="philosophy-title" class="philosophy__title">{t.philosophy.title}</h2>
      <p class="philosophy__body">{t.philosophy.body}</p>
    </div>
  </div>
</section>

<style>
  .philosophy {
    position: relative;
  }

  .deco {
    display: none;
  }

  /* ---- モバイル (既定): 写真を文章の背面に敷き、中央揃え ---- */
  .philosophy__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    padding: var(--space-section-y) var(--space-section-x);
    text-align: center;
  }

  .philosophy__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
  }

  .philosophy__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.25);
  }

  .philosophy__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-brand) 85%, transparent),
      color-mix(in srgb, var(--color-brand) 50%, transparent),
      color-mix(in srgb, var(--color-brand) 85%, transparent)
    );
  }

  .philosophy__text {
    position: relative;
    z-index: 1;
    max-width: 92vw;
    margin-inline: auto;
  }

  .philosophy__title {
    margin-bottom: var(--space-stack);
    font-size: var(--text-title-mobile);
    line-height: var(--leading-title);
    letter-spacing: var(--tracking-wide);
    white-space: pre-line;
  }

  .philosophy__body {
    font-size: var(--text-body-mobile);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-soft);
    white-space: pre-line;
  }

  /* ---- デスクトップ: 左 55% に高さ 700px の写真、右 45% に文章を縦中央で並べる ---- */
  @media (min-width: 48rem) {
    .philosophy {
      padding: var(--space-section-y-md) var(--space-section-x-md);
    }

    .deco {
      display: block;
      pointer-events: none;
    }

    .deco__dot {
      position: absolute;
      border-radius: var(--radius-full);
      filter: blur(1px);
    }

    .deco__dot--1 {
      top: 96px;
      right: 8%;
      width: 6px;
      height: 6px;
      background: color-mix(in srgb, var(--color-accent) 40%, transparent);
    }

    .deco__dot--2 {
      right: 18%;
      bottom: 128px;
      width: 4px;
      height: 4px;
      background: color-mix(in srgb, var(--color-dot-yellow) 30%, transparent);
    }

    .philosophy__inner {
      position: static;
      justify-content: space-between;
      gap: 32px;
      width: 100%;
      max-width: var(--container);
      min-height: 0;
      margin-inline: auto;
      padding: 0;
      text-align: left;
    }

    .philosophy__photo {
      position: relative;
      inset: auto;
      flex: none;
      width: 55%;
      height: 700px;
    }

    /* 現行の左上の赤い光点 */
    .philosophy__photo::before {
      content: '';
      position: absolute;
      top: -40px;
      left: -40px;
      z-index: 10;
      width: 8px;
      height: 8px;
      border-radius: var(--radius-full);
      background: var(--color-dot-red);
      filter: blur(1px);
    }

    .philosophy__photo::after {
      display: none;
    }

    .philosophy__text {
      width: 45%;
      max-width: none;
      margin: 0;
    }

    .philosophy__title {
      margin-bottom: var(--space-stack-lg);
      font-size: var(--text-title);
    }

    .philosophy__body {
      font-size: var(--text-body);
    }
  }
</style>
