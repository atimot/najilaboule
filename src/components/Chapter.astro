---
/**
 * 献立の 1 章 (壱〜四)。左右に写真 (4:3) と文章列を並べ、文章は縦書き (h2 が右、本文が左)。
 * 写真は images.ts に章ごとに 1 枚以上登録し、2 枚以上なら CSS だけのスライドショーで順に見せる。
 * 4 章の並びと写真の扱いは Chapters.astro が持つ。
 */
import { Picture } from 'astro:assets';
import { images } from '@/assets/images';
import { getCopy, type ChapterKey } from '@/i18n';

/** スライドショーの枚数の上限。<style> に keyframes (chapter-slide-2 〜 5) を用意した枚数まで */
const MAX_SLIDES = 5;

interface Props {
  /** 章のキー = セクションの id (#concept など) */
  chapter: ChapterKey;
  /** 写真を右に置く (弐・四)。文章列は右寄せになる */
  reverse?: boolean;
  /** 写真の object-position (handoff §3)。章の全写真に共通 */
  photoPosition?: string;
  /** 写真の減光 brightness() (handoff §3)。章の全写真に共通 */
  photoBrightness?: number;
}

const { chapter, reverse = false, photoPosition = '50% 50%', photoBrightness = 0.75 } = Astro.props;
const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';
const t = getCopy(lang);
const c = t.chapters[chapter];
const photos = images.chapters[chapter];
const slideshow = photos.length > 1;
if (photos.length > MAX_SLIDES) {
  throw new Error(
    `Chapter "${chapter}": 写真は ${MAX_SLIDES} 枚まで (${photos.length} 枚登録されている)。増やすなら Chapter.astro の keyframes を足す`,
  );
}
const titleId = `${chapter}-title`;
---

<section
  id={chapter}
  class:list={['chapter', reverse && 'chapter--reverse']}
  aria-labelledby={titleId}
  style={`--photo-position: ${photoPosition}; --photo-brightness: ${photoBrightness}`}
>
  <figure class="chapter__photo reveal">
    <!-- 写真は枠に重ねる。2 枚以上なら --slide-count / --slide-name でスライドショーを動かす -->
    <div
      class:list={['chapter__frame', slideshow && 'chapter__frame--slideshow']}
      style={slideshow ? `--slide-count: ${photos.length}; --slide-name: chapter-slide-${photos.length}` : undefined}
    >
      {
        photos.map((photo, i) => (
          <div class="chapter__slide" style={`--i: ${i}`}>
            <Picture
              src={photo.src}
              formats={['avif', 'webp']}
              widths={[800, 1600]}
              sizes="(min-width: 48rem) 48rem, 100vw"
              alt={photo.alt[lang]}
            />
          </div>
        ))
      }
    </div>
    {c.note && <figcaption class="chapter__note">{c.note}</figcaption>}
  </figure>

  <div class="chapter__text reveal">
    <p class="chapter__kicker">
      <span class="chapter__number">{c.number}</span>
      <span class="chapter__label">{c.label}</span>
    </p>
    <!-- 縦書き。vertical-rl の flex column は右 → 左に並ぶので h2 が右、本文が左 -->
    <div class="chapter__vertical">
      <h2 id={titleId} class="chapter__title">{c.title}</h2>
      <p class="chapter__body">{c.body}</p>
    </div>
  </div>
</section>

<style>
  /* 写真 60 : 文章 40。300px を下限に、狭ければ写真 → 文章の順に 1 列へ折り返す */
  .chapter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-stack-xl);
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
  }

  /* 弐・四は写真が右。wrap しても行の順は変わらないので写真が上に来る */
  .chapter--reverse {
    flex-direction: row-reverse;
  }

  .chapter__photo {
    flex: 60 1 0px;
    min-width: min(100%, 300px);
    margin: 0;
  }

  .chapter__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  /* 写真は枠いっぱいに重ねる。静止状態は 1 枚目だけ見え、2 枚目以降は透明。
     1 枚のときと reduced-motion (global.css で animation を止める) ではこの静止状態のまま */
  .chapter__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .chapter__slide:first-child {
    opacity: 1;
  }

  .chapter__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-position);
    filter: brightness(var(--photo-brightness));
  }

  /* 下勾配: 写真の下端を brand に溶かす。スライド (z-index 0〜2) より上に置く */
  .chapter__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(to top, var(--color-brand), transparent 45%);
    opacity: 0.6;
    pointer-events: none;
  }

  /* スライドショー (2 枚以上): 各写真を 5 秒見せ、1 秒で次の写真が上に溶けて現れ、
     隠れた前の写真は次が現れきってから瞬時に消える (両方が半透明になる瞬間を作らず、焦茶を透けさせない)。
     1 枚あたりの周期 (--slide-period) は 6 秒。フェードは周期の 1/6 に固定してあるので、周期だけ変えれば keyframes はそのまま使える。
     1 周は枚数 × 周期。i 枚目は i 周期ぶん遅らせて始め、全体を fade ぶん前倒しして 1 枚目が最初から見えているようにする。
     ホバーで止めたり拡大したりはしない (挙動を単純に保つ) */
  .chapter__frame--slideshow {
    --slide-period: 6s;
    --slide-fade: calc(var(--slide-period) / 6);
  }

  .chapter__frame--slideshow .chapter__slide {
    animation: var(--slide-name) calc(var(--slide-count) * var(--slide-period)) var(--ease-in-out)
      calc(var(--i) * var(--slide-period) - var(--slide-fade)) infinite;
  }

  /* keyframes は枚数 n ごとに割合が変わるので 2〜5 枚ぶんを置く (MAX_SLIDES)。
     1 周を 100% として、a = fade / 周 (現れきる)、b = 1 / n (次が上に現れ始める)、c = (period + fade) / 周 (次が現れきる)。
     フェードが周期の 1/6 なので a = 100 / (6n)、b = 100 / n、c = 700 / (6n) (%)。
     z-index は現れる間 2、見せている間 1 (次が上に来る)、消えたら 0。c から 100% は step-start で瞬時に消す */
  @keyframes chapter-slide-2 {
    0% { opacity: 0; z-index: 2; }
    8.3333% { opacity: 1; z-index: 2; }
    50% { opacity: 1; z-index: 1; }
    58.3333% { opacity: 1; z-index: 1; animation-timing-function: step-start; }
    100% { opacity: 0; z-index: 0; }
  }

  @keyframes chapter-slide-3 {
    0% { opacity: 0; z-index: 2; }
    5.5556% { opacity: 1; z-index: 2; }
    33.3333% { opacity: 1; z-index: 1; }
    38.8889% { opacity: 1; z-index: 1; animation-timing-function: step-start; }
    100% { opacity: 0; z-index: 0; }
  }

  @keyframes chapter-slide-4 {
    0% { opacity: 0; z-index: 2; }
    4.1667% { opacity: 1; z-index: 2; }
    25% { opacity: 1; z-index: 1; }
    29.1667% { opacity: 1; z-index: 1; animation-timing-function: step-start; }
    100% { opacity: 0; z-index: 0; }
  }

  @keyframes chapter-slide-5 {
    0% { opacity: 0; z-index: 2; }
    3.3333% { opacity: 1; z-index: 2; }
    20% { opacity: 1; z-index: 1; }
    23.3333% { opacity: 1; z-index: 1; animation-timing-function: step-start; }
    100% { opacity: 0; z-index: 0; }
  }

  .chapter__note {
    margin-top: 12px;
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .chapter__text {
    display: flex;
    flex: 40 1 0px;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    min-width: min(100%, 300px);
  }

  .chapter--reverse .chapter__text {
    align-items: flex-end;
  }

  /* 章番号 (label / text-muted) + 仏語ラベル (label-wide / accent) */
  .chapter__kicker {
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-size: var(--text-label);
    line-height: var(--leading-label);
  }

  .chapter__number {
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .chapter__label {
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
  }

  /* 縦書きブロック。高さは本文 1 行 (23 文字以内) と見出し 1 列 (9 文字以内) が折り返さない 420px 以上 */
  .chapter__vertical {
    display: flex;
    flex-direction: column;
    gap: 40px;
    height: clamp(420px, 34vw, 440px);
    writing-mode: vertical-rl;
  }

  .chapter__title {
    font-size: var(--text-headline-mobile);
    line-height: var(--leading-headline);
    letter-spacing: var(--tracking-wide);
    white-space: pre-line;
  }

  /* 行間 2 が縦書きでは列の間隔になる */
  .chapter__body {
    font-size: var(--text-body-mobile);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-soft);
    white-space: pre-line;
  }

  @media (min-width: 48rem) {
    .chapter__title {
      font-size: var(--text-headline);
    }

    .chapter__body {
      font-size: var(--text-body);
    }
  }
</style>
