---
import { Picture } from 'astro:assets';
import BrandLockup from '@/components/BrandLockup.astro';
import { images } from '@/assets/images';
import { SITE } from '@/config';
import { getCopy } from '@/i18n';

const lang = Astro.currentLocale === 'en' ? 'en' : 'ja';
const t = getCopy(lang);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(SITE.mapQuery)}&output=embed&hl=${lang}`;
---

<section id="access" class="access section" aria-labelledby="access-title">
  <!-- 背景写真 (0.3 に減光 + 彩度 0.7)。上下を brand で締める -->
  <div class="access__bg" aria-hidden="true">
    <Picture src={images.access.src} formats={['avif', 'webp']} widths={[800, 1600, 2400]} sizes="100vw" alt="" />
    <div class="access__overlay"></div>
  </div>

  <div class="access__inner container">
    <div class="access__head reveal">
      <span class="label access__label">{t.access.label}</span>
      <!-- 見出しはアイコン + ロゴのロックアップ。見出し文字列としてはロゴ (role="img") の aria-label が読まれる -->
      <h2 id="access-title" class="access__title">
        <BrandLockup label={`${SITE.name} ${SITE.kana}`} />
      </h2>
    </div>

    <div class="info reveal">
      <div>
        <p class="field__label">ADDRESS</p>
        <p class="field__value">{t.access.address}</p>
      </div>
      <div>
        <p class="field__label">TEL</p>
        <p class="field__value">
          <a href={SITE.phoneHref} class="tel">{SITE.phone}</a>
        </p>
      </div>
      <div>
        <p class="field__label">HOURS</p>
        <p class="field__value field__value--nums">
          {t.access.hoursMain}
          <br />
          <span class="field__note">{t.access.hoursClosed}</span>
        </p>
      </div>
    </div>

    <!-- 地図はグレースケールにして世界観に沈める -->
    <div class="map reveal">
      <iframe
        class="map__frame"
        title={t.access.mapTitle}
        src={mapSrc}
        width="100%"
        height="100%"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .access {
    position: relative;
    overflow: hidden;
  }

  .access__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .access__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 40%;
    filter: brightness(0.3) saturate(0.7);
  }

  .access__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-brand),
      color-mix(in srgb, var(--color-brand) 40%, transparent),
      var(--color-brand)
    );
  }

  .access__inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .access__head {
    margin-bottom: var(--space-stack-xl);
  }

  .access__label {
    margin-bottom: 24px;
  }

  .access__title {
    --lockup-height: var(--logo-height-access-mobile);

    margin: 0;
  }

  /* ADDRESS / TEL / HOURS。200px を下限に 1〜3 列へ自動で折り返す。幅 56rem は 3 列が間延びしない上限 */
  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: var(--space-stack) var(--space-stack-lg);
    max-width: 56rem;
    margin: 0 auto var(--space-stack-xl);
  }

  .field__label {
    margin-bottom: 4px;
    font-size: var(--text-label);
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .field__value {
    white-space: pre-line;
  }

  .field__value--nums,
  .tel {
    font-variant-numeric: tabular-nums;
  }

  .tel {
    transition: color var(--duration-hover);
  }

  .tel:hover {
    color: var(--color-accent);
  }

  .field__note {
    font-size: var(--text-label);
    line-height: var(--leading-label);
    color: var(--color-text-muted);
  }

  .map {
    width: 100%;
    height: 320px;
  }

  .map__frame {
    display: block;
    border: 0;
    filter: grayscale(100%) brightness(0.85);
  }

  @media (min-width: 48rem) {
    .access__title {
      --lockup-height: var(--logo-height-access);
    }
  }
</style>
