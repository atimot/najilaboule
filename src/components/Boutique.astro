---
import Button from '@/components/Button.astro';
import { SITE } from '@/config';
import { getCopy } from '@/i18n';

const t = getCopy(Astro.currentLocale);
---

<section id="shop" class="boutique" aria-labelledby="boutique-title">
  <!-- 背景写真は置かない。1px の罫線 (line) で囲った中央寄せの箱 -->
  <div class="boutique__box container container--narrow reveal">
    <span class="label">BOUTIQUE</span>
    <h2 id="boutique-title" class="boutique__title">{t.boutique.title}</h2>
    <p class="boutique__body">{t.boutique.body}</p>
    <Button href={SITE.riceShopUrl} ariaLabel={`ONLINE SHOP: ${t.boutique.ctaAriaLabel}`} variant="outline" size="md" external class="boutique__cta">
      ONLINE SHOP <span aria-hidden="true">↗</span>
    </Button>
  </div>
</section>

<style>
  /* 章の列 (Chapters) の直後なので上の余白は 0。下だけ section-y */
  .boutique {
    padding: 0 var(--space-section-x) var(--space-section-y);
  }

  .boutique__box {
    padding: clamp(48px, 8vw, 96px) var(--space-section-x);
    border: 1px solid var(--color-line);
    text-align: center;
  }

  .boutique__title {
    margin-bottom: var(--space-stack);
    font-size: var(--text-headline-mobile);
    line-height: var(--leading-headline);
    letter-spacing: var(--tracking-wide);
    white-space: pre-line;
  }

  .boutique__body {
    margin-bottom: var(--space-stack-lg);
    font-size: var(--text-body-mobile);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-soft);
    white-space: pre-line;
  }

  /* ONLINE SHOP は md ボタンより左右が広い (40px) */
  .boutique :global(.boutique__cta) {
    padding-inline: 40px;
  }

  @media (min-width: 48rem) {
    .boutique {
      padding: 0 var(--space-section-x-md) var(--space-section-y-md);
    }

    .boutique__box {
      padding-inline: var(--space-section-x-md);
    }

    .boutique__title {
      font-size: var(--text-headline);
    }

    .boutique__body {
      font-size: var(--text-body);
    }
  }
</style>
